# Jev (TypeSafe System One). Free tier keys start with jv_live_ and use the
# jev-agent.com host; TypeSafe keys use api.typesafe.ai. Keys are host-specific.
JEV_API_KEY=jv_live_xxxxxxxxxxxx
JEV_BASE_URL=https://jev-agent.com/api/v1/systemone
JEV_MODEL=jev-latest

# Only needed for `--live` ingestion of real GitHub Actions runs.
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
