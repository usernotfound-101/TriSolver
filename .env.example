# Copy to .env and fill in. Both are optional: with neither set, TriSolver
# runs against the recorded fixtures with a clearly-labelled offline Jev.

# ---------------------------------------------------------------- Jev
# Keys are host-specific and not interchangeable:
#   free tier   jv_live_...   ->  https://jev-agent.com/api/v1/systemone
#   TypeSafe    (their key)   ->  https://api.typesafe.ai/v1/systemone
JEV_API_KEY=jv_live_xxxxxxxxxxxx
JEV_BASE_URL=https://jev-agent.com/api/v1/systemone
JEV_MODEL=jev-latest

# ---------------------------------------------------------------- GitHub
# Only needed for --live ingestion. Fine-grained PAT scopes: Actions read,
# Pull requests read, Contents read. Classic PAT: repo.
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
